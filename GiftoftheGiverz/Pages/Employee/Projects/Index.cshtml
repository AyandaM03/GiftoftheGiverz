@page
@model GiftoftheGiverz.Pages.Employee.Projects.IndexModel

@{
    ViewData["Title"] = "Relief Projects";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Relief Projects</h1>
            <p class="text-muted">
                Manage ongoing humanitarian relief projects.
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            + Create Project
        </a>
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="alert alert-info">
            No relief projects have been created yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model.Projects)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <h5 class="card-title fw-bold">
                                    @project.Name
                                </h5>

                                <span class="badge
                                            @(project.Status == "Completed"
                                                                              ? "bg-success"
                                                                              : project.Status == "Ongoing"
                                                                                  ? "bg-primary"
                                                                                  : "bg-secondary")">
                            @project.Status
                        </span>

                            </div>

                            <p class="card-text">
                                @project.Description
                            </p>

                            <p class="mb-2">
                                <strong>Location:</strong>
                                @project.Location
                            </p>

                            <p class="mb-3">
                                <strong>Start Date:</strong>
                                @project.StartDate.ToString("dd MMM yyyy")
                            </p>

                            <a asp-page="./Details"
                               asp-route-id="@project.ReliefProjectId"
                               class="btn btn-outline-primary">
                                View Project
                            </a>

                        </div>

                    </div>

                </div>
                }

        </div>
    }

</div>