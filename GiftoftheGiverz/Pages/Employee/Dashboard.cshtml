@page
@model GiftoftheGiverz.Pages.Employee.DashboardModel

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container py-5">

    <div class="mb-5">

        <h1 class="fw-bold">
            Employee Dashboard
        </h1>

        <p class="text-muted">
            Manage humanitarian relief projects and volunteer
            registrations.
        </p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <h4 class="fw-bold">
                        Relief Projects
                    </h4>

                    <p class="text-muted">
                        Create and manage humanitarian relief projects.
                    </p>

                    <a asp-page="/Employee/Projects/Index"
                       class="btn btn-primary">
                        Manage Projects
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <h4 class="fw-bold">
                        Post Updates
                    </h4>

                    <p class="text-muted">
                        Share progress and important updates
                        about relief projects.
                    </p>

                    <a asp-page="/Employee/Updates/Create"
                       class="btn btn-primary">
                        Post Update
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <h4 class="fw-bold">
                        Volunteers
                    </h4>

                    <p class="text-muted">
                        View people who have registered to volunteer.
                    </p>

                    <a asp-page="/Employee/Volunteers/Dashboard"
                       class="btn btn-primary">
                        View Volunteers
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>