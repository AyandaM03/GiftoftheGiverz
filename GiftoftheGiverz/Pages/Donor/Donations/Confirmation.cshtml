@page
@model GiftoftheGiverz.Pages.Donor.Donations.ConfirmationModel

@{
    ViewData["Title"] = "Donation Confirmation";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-5 text-center">

                    <div class="mb-4">
                        <div class="display-4">✓</div>
                    </div>

                    <h1 class="fw-bold">
                        Thank You for Your Donation
                    </h1>

                    <p class="lead text-muted">
                        Your contribution has been recorded successfully.
                    </p>

                    @if (Model.Donation != null)
                    {
                        <div class="card bg-light border-0 my-4">

                            <div class="card-body">

                                <p class="mb-2">
                                    <strong>Reference Number:</strong>
                                    @Model.Donation.ReferenceNumber
                                </p>

                                <p class="mb-2">
                                    <strong>Amount:</strong>
                                    @Model.Donation.Currency
                                    @Model.Donation.Amount.ToString("N2")
                                </p>

                                <p class="mb-2">
                                    <strong>Donation Type:</strong>
                                    @Model.Donation.DonationType
                                </p>

                                @if (Model.Donation.DonationType == "Recurring")
                                {
                                    <p class="mb-2">
                                        <strong>Frequency:</strong>
                                        @Model.Donation.RecurringFrequency
                                    </p>
                                }

                                <p class="mb-0">
                                    <strong>Date:</strong>
                                    @Model.Donation.DonationDate.ToString("dd MMMM yyyy HH:mm")
                                </p>

                            </div>

                        </div>
                    }

                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                        @if (Model.Donation != null)
                        {
                            <a asp-page="/Donor/TaxCertificates/Index"
                               asp-route-donationId="@Model.Donation.DonationId"
                               class="btn btn-success">

                                View Tax Certificate

                            </a>
                        }

                        <a asp-page="/Index"
                           class="btn btn-outline-primary">
                            Return Home
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
