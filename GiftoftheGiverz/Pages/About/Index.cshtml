@page
@model GiftoftheGiverz.Pages.About.IndexModel

@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>About Gift of the Givers</h1>
            <p class="lead">Gift of the Givers is a humanitarian relief organisation focused on fast, effective assistance to communities affected by crises.</p>

            <h4>Our Mission</h4>
            <p>To provide lifesaving support and recovery assistance to vulnerable communities, working with local partners and volunteers to deliver sustained impact.</p>

            <h4>Our Values</h4>
            <ul>
                <li>Compassion</li>
                <li>Accountability</li>
                <li>Transparency</li>
                <li>Community-led solutions</li>
            </ul>
        </div>
        <div class="col-md-4">
            <img src="https://www.musina.gov.za/gift-of-the-givers-foundation-comes-to-the-rescue/" class="img-fluid rounded" alt="Humanitarian relief" />
        </div>
    </div>

    <div class="row">
        <div class="col">
            <h5>How we work</h5>
            <p>We coordinate with local networks to identify needs quickly and deliver aid where it is most needed. This project is a university-level prototype demonstrating a donation and volunteer system.</p>
        </div>
    </div>
</div>